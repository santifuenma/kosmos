# ─────────────────────────────────────────────────────────────────────────────
# .env.example — plantilla de variables de entorno para Kosmos.
#
# Copia este fichero como `.env` y rellena cada variable con un valor real.
# El fichero `.env` está en .gitignore: nunca lo subas al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Supabase / PostgreSQL) ────────────────────────────────────
# Kosmos usa PostgreSQL gestionado por Supabase mediante el driver adapter
# @prisma/adapter-pg. Necesitas DOS cadenas de conexión, que Supabase muestra en
# el botón "Connect" → pestaña "ORMs" → "Prisma":
#
#   DATABASE_URL → pooler en modo transacción (puerto 6543). La usa la app en
#                  runtime; es la adecuada para entornos serverless (Vercel).
#   DIRECT_URL   → pooler en modo sesión / conexión directa (puerto 5432). La
#                  usa la CLI de Prisma para ejecutar migraciones.
#
# Recuerda añadir `?pgbouncer=true` al final de DATABASE_URL (pooler de transacción).
DATABASE_URL="postgresql://postgres.PROYECTO:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROYECTO:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Clave usada para firmar los JWT de sesión. Genera una nueva con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca uses la misma clave en producción que en desarrollo y nunca la subas a git.
NEXTAUTH_SECRET=

# URL pública desde la que se accede a la aplicación. En desarrollo local es
# http://localhost:3000. En Vercel, ponla igual al dominio del despliegue,
# por ejemplo https://kosmos.vercel.app (sin barra final).
NEXTAUTH_URL=http://localhost:3000
